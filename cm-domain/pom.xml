<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cm</groupId>
        <artifactId>car-monitoring</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cm-domain</artifactId>
    <name>cm-domain</name>
    <description>业务规则与领域模型，不依赖 Controller 与具体传输实现</description>

    <dependencies>
        <dependency>
            <groupId>com.cm</groupId>
            <artifactId>cm-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>keep-domain-decoupled</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <message>cm-domain 不得依赖 Spring Boot starter、HTTP 层、Netty 或数据库驱动</message>
                                    <excludes>
                                        <exclude>org.springframework.boot:*</exclude>
                                        <exclude>io.netty:*</exclude>
                                        <exclude>com.mysql:*</exclude>
                                        <exclude>org.mongodb:*</exclude>
                                        <exclude>com.baizhukui:*</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
